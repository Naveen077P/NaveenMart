import java.util.*;
public class ProductDisplay {
    public static void showProducts() {
        System.out.println("\n==========================================");
        System.out.println("           AVAILABLE PRODUCTS");
        System.out.println("==========================================");
        if (NaveenMart1.productManager.getProducts().isEmpty()) {
            System.out.println("No products available.");
            return;
        }
        System.out.printf("%-5s %-15s %-12s %-20s%n","ID", "Product", "Price", "Category");
        System.out.println("------------------------------------------");
        for (Product p : NaveenMart1.productManager.getProducts()) {
            System.out.printf("%-5d %-15s ₹%-11.2f %-20s%n",p.getId(), p.getName(), p.getPrice(), p.getCategory());
        }
    }
}
